PORT=4000
# Frontend origin(s) allowed to call the API with cookies; comma-separated for more than one
CORS_ORIGIN=http://localhost:3000
# Base URL used in password-reset links (defaults to the first CORS_ORIGIN)
APP_URL=http://localhost:3000
# PostgreSQL connection string
DATABASE_URL=postgresql://kyvag:change-me@localhost:5432/kyvag?schema=public
# Defaults to true when NODE_ENV=production; must be true when served over HTTPS
COOKIE_SECURE=false
# Who may set X-Forwarded-For, so rate limits see real client IPs: "loopback" for the Next.js proxy on the same machine, or a hop count (e.g. 1) behind a load balancer
TRUST_PROXY=loopback

// Kyvag CRM database. After changing this file run `npm run db:migrate` (creates a migration and regenerates the client).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Accounts ----

enum Role {
  admin
  manager
  rep
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique // stored lower-cased
  name         String
  title        String?
  phone        String?
  role         Role     @default(admin)
  /// null for an account that can't sign in yet
  passwordHash String?  @map("password_hash")
  failedLogins Int      @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions       Session[]
  passwordTokens PasswordToken[]
  leads          Lead[]
  activities     Activity[]

  @@map("users")
}

/// Only the SHA-256 of each token is stored, so a leaked database can't be used to sign in
model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  persistent Boolean
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time password reset links
model PasswordToken {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_tokens")
}

// ---- CRM ----

/// The pipeline, in order. "churned" is never stored here: it's an outcome, not a step.
model Stage {
  id       String @id
  label    String
  color    String
  position Int

  @@map("stages")
}

/// A customer is a lead in the "paid" stage. stage isn't a relation: "churned" isn't a row in stages.
model Lead {
  id            String    @id // "L-2041"
  seq           Int       @unique // the number in the id, for issuing the next one
  name          String
  company       String
  email         String?
  phone         String?
  domain        String?
  city          String?
  language      String?
  source        String
  stage         String
  score         Int       @default(50)
  ownerId       String?   @map("owner_id")
  platform      String    @default("None")
  storeSize     String?   @map("store_size")
  category      String?
  tags          String[]  @default([])
  utm           Json?
  /// Other channels the same merchant also came in from
  duplicates    String[]  @default([])
  lastActivity  String?   @map("last_activity")
  firstReplyMin Float?    @map("first_reply_min")
  trialDay      Int?      @map("trial_day")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  /// When the lead last moved to "paid"
  paidAt        DateTime? @map("paid_at")

  owner      User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]

  @@index([createdAt])
  @@index([stage, createdAt])
  @@index([paidAt])
  @@map("leads")
}

model Activity {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  kind      String
  text      String
  /// null for entries the system logged
  authorId  String?  @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("activities")
}

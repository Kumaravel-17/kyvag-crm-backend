# Copy to deploy/.env on the server and fill in.

# Address people open in the browser: http://<server IP> for now, https://crm.example.com once a domain points here
APP_URL=http://203.0.113.10
# ":80" for plain HTTP; set to the domain (crm.example.com) for automatic HTTPS, and then COOKIE_SECURE=true
SITE_ADDRESS=:80
COOKIE_SECURE=false

# Database password; letters and digits only, since it goes into a URL
POSTGRES_PASSWORD=change-me

# Where the frontend repo (crm-kyvag) is checked out, relative to this folder
FRONTEND_DIR=../../crm-kyvag
